---
// LAB v6 — layout lado a lado (texto | imagem), shader WebGL de fundo,
// sem marca d'água. Tentamos ícones de canal na ponta de raios de luz,
// mas não dava pra prender eles nos traços que o próprio shader desenha
// (são procedurais, sem posição previsível) — tirado por decisão do Diego,
// o resto ficou bom sem.
import { Image } from 'astro:assets';
import dashboardImg from '../assets/dashboard.png';
import ShaderCanvas from './ShaderCanvas.tsx';
---
<section class="hero-v3">
  <ShaderCanvas client:load />

  <div class="hero-v3-grid">
    <div class="hero-v3-inner">
      <span class="badge eyebrow"><span class="live-dot"></span>Omnichannel + CRM + Automação em um só lugar</span>
      <h1 class="hero-title">
        <span class="kick" style="--d:0s">Atendimento Omnichannel</span> <br />
        <span class="kick gradient-text" style="--d:0.12s">para Alta Conversão.</span>
      </h1>
      <p class="hero-subtitle">
        A plataforma ideal para pequenas e grandes empresas. Escale suas vendas centralizando WhatsApp, Instagram e Facebook, com automação inteligente e CRM integrado.
      </p>
      <div class="hero-actions">
        <a href="https://wa.me/5531987771763" target="_blank" rel="noopener noreferrer" class="primary-button">
          Solicitar Demonstração
        </a>
      </div>
      <div class="hero-stats">
        <div class="stat-item"><span class="stat-number">+10k</span><span class="stat-label">Usuários Ativos</span></div>
        <div class="stat-item"><span class="stat-number">99.9%</span><span class="stat-label">Uptime</span></div>
      </div>
    </div>

    <div class="frame-stage">
      <div class="browser-frame glass-card">
        <div class="browser-chrome">
          <span class="chrome-dot" style="background:#ff5f57"></span>
          <span class="chrome-dot" style="background:#febc2e"></span>
          <span class="chrome-dot" style="background:#28c840"></span>
          <div class="browser-url">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            app.chatzp.com.br
          </div>
        </div>
        <Image src={dashboardImg} alt="Plataforma ChatZP Dashboard" class="dashboard-img" width={820} format="webp" quality={85} loading="eager" fetchpriority="high" decoding="async" />
      </div>

      <div class="bento-pill pill-wa glass-card">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="#25D366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        <div><strong>+248</strong><span>mensagens hoje</span></div>
      </div>
      <div class="bento-pill pill-ig glass-card">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#E1306C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        <div><strong>32</strong><span>novos leads</span></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Hero escuro de propósito — só esta seção. */
  .hero-v3 {
    position: relative; padding: 10rem 5% 6rem; overflow: hidden;
    background: #0a0314; /* fallback: mesma base do shader, se WebGL2 não existir */
  }

  /* Canvas real (WebGL2 + fractal noise) — ver ShaderCanvas.tsx. */
  :global(.shader-canvas) {
    position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%;
    display: block; pointer-events: none;
  }

  .hero-v3-grid {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 4rem; align-items: center;
  }

  .hero-v3-inner .eyebrow {
    display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem; font-size: 0.8rem;
    background: rgba(255,255,255,0.08); color: #e8ddff; border: 1px solid rgba(255,255,255,0.12);
  }
  .live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 rgba(0,255,136,.6); animation: pulse-dot 1.8s ease-out infinite; }
  .hero-v3-inner .hero-title { margin-bottom: 1.5rem; color: #fff; }
  .hero-v3-inner .hero-title .gradient-text {
    background: linear-gradient(135deg, #c9a3ff, var(--accent));
    background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  }
  .hero-v3-inner .hero-subtitle { margin-bottom: 2.5rem; max-width: 520px; color: rgba(255,255,255,0.65); }
  .hero-v3-inner .primary-button { box-shadow: 0 0 40px rgba(124, 47, 214, 0.6), var(--shadow-glow); }
  .hero-v3-inner .stat-number { color: #fff; }
  .hero-v3-inner .stat-label { color: rgba(255,255,255,0.5); }

  /* Título entra com energia, sem quique: desaceleração exponencial. */
  .kick {
    display: inline-block;
    animation: kick-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--d, 0s);
  }
  @keyframes kick-in {
    0% { opacity: 0; transform: translateY(26px) scale(0.96); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes pulse-dot {
    0% { box-shadow: 0 0 0 0 rgba(0,255,136,.6); }
    70% { box-shadow: 0 0 0 7px rgba(0,255,136,0); }
    100% { box-shadow: 0 0 0 0 rgba(0,255,136,0); }
  }

  .frame-stage { position: relative; z-index: 1; }

  .browser-frame {
    border-radius: 16px; overflow: hidden; padding: 0; position: relative; z-index: 2;
    animation: float 7s ease-in-out infinite;
  }
  .browser-chrome {
    display: flex; align-items: center; gap: 0.4rem;
    padding: 0.75rem 1rem; background: rgba(255,255,255,0.6);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  .chrome-dot { width: 10px; height: 10px; border-radius: 50%; }
  .browser-url {
    margin: 0 auto; display: flex; align-items: center; gap: 0.4rem;
    font-size: 0.78rem; color: var(--gray-medium);
    background: rgba(0,0,0,0.04); border-radius: 999px; padding: 0.25rem 1rem;
  }
  .browser-frame .dashboard-img { display: block; width: 100%; height: auto; border-radius: 0; box-shadow: none; }

  .bento-pill {
    position: absolute; z-index: 2; display: flex; align-items: center; gap: 0.7rem;
    padding: 0.7rem 1.1rem; border-radius: 14px; font-size: 0.82rem;
    animation: float-alt 6s ease-in-out infinite;
  }
  .bento-pill strong { display: block; font-size: 0.95rem; color: var(--text-dark); }
  .bento-pill span { color: var(--gray-medium); }
  .pill-wa { top: -1.25rem; left: -1.25rem; animation-delay: 0s; }
  .pill-ig { bottom: -1.25rem; right: -1rem; animation-delay: 1.5s; }

  @media (max-width: 1024px) {
    .hero-v3 { padding: 9rem 5% 4rem; }
    .hero-v3-grid { grid-template-columns: 1fr; gap: 3.5rem; text-align: center; }
    .hero-v3-inner .hero-subtitle { margin-inline: auto; }
    .hero-v3-inner .hero-actions { justify-content: center; }
    .hero-v3-inner .hero-stats { justify-content: center; }
    .frame-stage { max-width: 480px; margin: 0 auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .browser-frame, .bento-pill, .live-dot { animation: none; }
    .kick { animation: none; opacity: 1; transform: none; }
  }
</style>
