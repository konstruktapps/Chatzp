---
// LAB — mesma técnica do AutomationV2 (Aceternity "Container Scroll Animation"), lado CRM.
import { Image } from 'astro:assets';
import crmImg from '../assets/crm.png';
---
<section id="crm-v2" class="crm">
  <div class="container-split reverse">
    <div class="crm-text">
      <div class="fade-in-left">
        <span class="badge">CRM Integrado</span>
        <h2 class="section-title">
          CRM de Vendas Integrado <br />
          <span class="gradient-text">à sua Comunicação</span>
        </h2>
        <p>Transforme cada conversa em receita. Controle cada oportunidade no funil de vendas, atribua contatos e tenha visibilidade total do desempenho da sua equipe comercial.</p>
        <div class="crm-features">
          <div class="crm-f-item">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            <div><h3>Randomização de Atendentes</h3><p>Distribua leads de forma justa (Round Robin) e automática.</p></div>
          </div>
          <div class="crm-f-item">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <div><h3>Carteira de Clientes</h3><p>Vincule clientes a atendentes específicos para um serviço personalizado.</p></div>
          </div>
        </div>
      </div>
    </div>
    <div class="crm-visual fade-in-right">
      <div class="scroll-tilt">
        <Image src={crmImg} alt="ChatZP CRM Pipeline" width={600} format="webp" quality={85} loading="lazy" />
      </div>
    </div>
  </div>
</section>

<style>
  .scroll-tilt { perspective: 1400px; }
  .scroll-tilt img {
    transform: rotateX(var(--tilt, 18deg)) scale(var(--tscale, 0.94));
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform;
    box-shadow: var(--shadow-premium);
    border-radius: 20px;
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-tilt img { transform: none !important; transition: none; }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const el = document.querySelector<HTMLElement>('#crm-v2 .scroll-tilt');
  if (el && !reduced) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        const ratio = Math.min(1, e.intersectionRatio / 0.8);
        el.style.setProperty('--tilt', `${18 * (1 - ratio)}deg`);
        el.style.setProperty('--tscale', `${0.94 + 0.06 * ratio}`);
      });
    }, { threshold: Array.from({ length: 21 }, (_, i) => i / 20) });
    io.observe(el);
  }
</script>
