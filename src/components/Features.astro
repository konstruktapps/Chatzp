---
const features = [
  { title: "Múltiplas Integrações Diretas", desc: "Integração nativa pronta com RD Station, Perfex, CVCRM e IXC.", svg: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="22" y1="12" x2="18" y2="12"/><line x1="6" y1="12" x2="2" y2="12"/><line x1="12" y1="6" x2="12" y2="2"/><line x1="12" y1="22" x2="12" y2="18"/></svg>` },
  { title: "Webhooks e n8n", desc: "Faça chamadas diretas para o n8n ou qualquer outro sistema via Webhooks no FlowBuilder.", svg: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 1.41 13.4"/><path d="M3.52 18.47a10 10 0 0 1 1.41-13.4"/></svg>` },
  { title: "Agendamento e Campanhas", desc: "Programe mensagens de aniversário, lembretes de cobrança ou ações de marketing via Tags.", svg: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><polyline points="9 16 11 18 15 14"/></svg>` },
  { title: "Histórico Unificado", desc: "Se o cliente trocar de rede social, o contexto da conversa flui com ele.", svg: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-.18-8.75"/></svg>` },
  { title: "Dashboards", desc: "Telas de monitoramento focadas na operação total da sua central.", svg: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>` },
  { title: "API Oficial & Segurança", desc: "Suporte 100% à API Oficial e COEX para blindar a sua operação de vendas.", svg: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>` },
  { title: "Controle de Tarefas", desc: "Crie e delegue tarefas para sua equipe. Gestão interna com prioridades e vencimento.", svg: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>` },
  { title: "Esteira de Produtos", desc: "Monte seu catálogo de produtos e crie pipelines de vendas com gatilhos automáticos.", svg: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>` },
  { title: "Avaliação de Atendimento", desc: "Colete CSAT por atendente ou consolidado e identifique gargalos de qualidade.", svg: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>` },
  { title: "Relatórios por Atendente", desc: "Veja quem mais atende, tempo de resposta e taxa de conversão por colaborador.", svg: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>` },
  { title: "Busca Avançada", desc: "Filtre conversas por usuário, conexão, tags, contato, fila, protocolo, data e texto.", svg: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>` },
  { title: "Chat Interno", desc: "Troca de mensagens internas entre membros da equipe sem sair da plataforma.", svg: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>` },
];
---
<section id="recursos" class="features-grid-section">
  <div class="section-header fade-in">
    <h2 class="section-title">O que tem debaixo do capô?</h2>
    <p class="section-subtitle">A infraestrutura robusta que sustenta as operações de vendas mais exigentes.</p>
  </div>
  <div class="adv-features-grid">
    {features.map((f) => (
      <div class="adv-feat-card fade-in">
        <div class="adv-feat-icon" set:html={f.svg} />
        <h3>{f.title}</h3>
        <p>{f.desc}</p>
      </div>
    ))}
  </div>
</section>
